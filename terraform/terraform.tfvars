# AWS Region
aws_region = "us-east-1"

# Your public IP address to allow SSH access. 
# Go to https://checkip.amazonaws.com to find yours.
# Make sure to add /32 at the end! Example: "203.0.113.10/32"
my_ip = "39.39.89.62/32"

# The name of the AWS EC2 Key Pair you created in the AWS Console.
# Ensure you have the .pem file downloaded to your local machine!
key_name = "devops-key"

# Instance Type
instance_type = "t3.micro"
